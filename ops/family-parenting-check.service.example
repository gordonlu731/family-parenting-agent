[Unit]
Description=Read-only family application database and backup check
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/family-parenting-agent
ExecStart=/usr/bin/docker compose -p family-parenting-agent exec -T app python scripts/operations.py check --source /data/family.sqlite3 --backup-dir /data/backups --max-age-hours 36 --min-free-mb 256
TimeoutStartSec=60
UMask=0077
