# Generate a different bootstrap token for your deployment. Never commit real keys.
BOOTSTRAP_TOKEN=
APP_DB=/data/family.sqlite3
APP_PORT=18080
PUBLIC_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
DEMO_MODE=false
# No model is called until all three model settings are configured.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_ID=
# qwen-plus JSON mode: false. Leave empty for providers without this parameter.
MODEL_ENABLE_THINKING=
# Includes failed provider attempts; applies to the whole family per Shanghai day.
MODEL_DAILY_REQUEST_LIMIT=30
# Inventory record reconfirmation interval, not a food-safety expiry period.
PANTRY_RECONFIRM_DAYS=7
